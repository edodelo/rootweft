include README.md LICENSE NOTICE ACKNOWLEDGMENTS CHANGELOG.md
include THIRD_PARTY_NOTICES.md PROVENANCE.md SECURITY.md PRIVACY.md
include DATA_EGRESS.md THREAT_MODEL.md CONTRIBUTING.md CODE_OF_CONDUCT.md
include requirements-dev.txt
recursive-include docs *.md
recursive-include skills *.md
recursive-include examples *
recursive-include tests *.py *.json *.md *.js *.jsx *.mjs *.cjs *.ts *.tsx *.pyi .env
recursive-include scripts *.py *.sh
prune .superpowers
prune .venv
global-exclude __pycache__ *.py[cod]
